# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The only email allowed to log in
ALLOWED_EMAIL=cenmarf@gmail.com

# platform.claude.com → API Keys (server-side only, never shown in the browser)
ANTHROPIC_API_KEY=sk-ant-xxx

# console.deepgram.com → API Keys (Member permission; server-side only)
DEEPGRAM_API_KEY=xxx

# ---- Phase 6: publishing ----
# Any long random string (40+ characters). Encrypts your account tokens. Never change it after connecting accounts.
ENCRYPTION_KEY=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Used only by the scheduler.
SUPABASE_SECRET_KEY=
# Any long random string. Vercel sends it when running the scheduler.
CRON_SECRET=
# Meta app (Facebook + Instagram): App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Threads (same Meta app, Threads use case → Settings)
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn developer app → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set to true only after LinkedIn approves the Community Management API (company page posting)
LINKEDIN_ORGANIZATION_POSTING=false

# ---- The Daily Canvas (/canvas) ----
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Redirect URI: https://YOUR-DOMAIN/api/canvas/google/callback  (see docs/canvas/INTEGRATIONS.md)
# Uses ENCRYPTION_KEY (above) to encrypt Google tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development/tests only: run /canvas without signing in, data kept in the browser.
# Ignored in production builds. Never set this in Vercel.
# NEXT_PUBLIC_CANVAS_LOCAL_ONLY=1
