# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The only email allowed to log in
ALLOWED_EMAIL=cenmarf@gmail.com

# platform.claude.com → API Keys (server-side only, never shown in the browser)
ANTHROPIC_API_KEY=sk-ant-xxx

# console.deepgram.com → API Keys (Member permission; server-side only)
DEEPGRAM_API_KEY=xxx

# ---- Phase 6: publishing ----
# Any long random string (40+ characters). Encrypts your account tokens. Never change it after connecting accounts.
ENCRYPTION_KEY=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Used only by the scheduler.
SUPABASE_SECRET_KEY=
# Any long random string. Vercel sends it when running the scheduler.
CRON_SECRET=
# Meta app (Facebook + Instagram): App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Threads (same Meta app, Threads use case → Settings)
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn developer app → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set to true only after LinkedIn approves the Community Management API (company page posting)
LINKEDIN_ORGANIZATION_POSTING=false

# ---- PromptSatori (/satori, and its own domain) ----
# Domains whose whole site is PromptSatori (comma-separated):
SATORI_HOSTS=promptsatori.com,www.promptsatori.com
# Generation provider. Claude uses ANTHROPIC_API_KEY above. Optional extra providers for
# generation and side-by-side testing (only appear when BOTH key and model list are set):
OPENAI_API_KEY=
# Comma-separated model ids your account can use:
OPENAI_MODELS=
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
# Comma-separated model ids, e.g. from Google AI Studio:
GEMINI_MODELS=
# Default generation provider (anthropic | openai | gemini). Users can change it in Settings.
# SATORI_PROVIDER=anthropic
# Cost controls for AI requests (per user). 0 disables a limit.
SATORI_RATE_PER_MINUTE=12
SATORI_DAILY_REQUEST_LIMIT=300
SATORI_MONTHLY_BUDGET_USD=25
# Prices for non-Claude models (USD per million tokens) so cost estimates work, e.g.
# SATORI_PRICES={"openai:your-model":{"input":1.25,"output":10}}
SATORI_PRICES=
# Local development/tests only (ignored in production builds):
# No sign-in, in-memory data:
# NEXT_PUBLIC_SATORI_LOCAL_ONLY=1
# Test-only mock AI, clearly labelled, never real output:
# SATORI_MOCK_PROVIDER=1

# ---- The Daily Canvas (/canvas) ----
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Redirect URI: https://YOUR-DOMAIN/api/canvas/google/callback  (see docs/canvas/INTEGRATIONS.md)
# Uses ENCRYPTION_KEY (above) to encrypt Google tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development/tests only: run /canvas without signing in, data kept in the browser.
# Ignored in production builds. Never set this in Vercel.
# NEXT_PUBLIC_CANVAS_LOCAL_ONLY=1

# ---- InboxSatori (/inbox) ----
# Uses ENCRYPTION_KEY (tokens + send confirmations), SUPABASE_SECRET_KEY (encrypted token store + scheduler),
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (add redirect URI https://YOUR-DOMAIN/api/inbox/gmail/callback),
# CRON_SECRET (background sync + scheduled briefings) and ANTHROPIC_API_KEY (optional AI). See docs/inbox/SETUP.md.
# Optional OpenAI support (chosen per user in Settings):
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_PRICE_IN=
# OPENAI_PRICE_OUT=
# Instant updates from Gmail (Pub/Sub push; not secret). See docs/inbox/SETUP.md §4b.
# GMAIL_PUBSUB_TOPIC=projects/YOUR-PROJECT-ID/topics/inboxsatori-gmail
# GMAIL_PUSH_AUDIENCE=https://inboxsatori.com/api/inbox/gmail/push
# GMAIL_PUSH_SERVICE_ACCOUNT=inboxsatori-push@YOUR-PROJECT-ID.iam.gserviceaccount.com
# Plan used when a workspace has no entitlement row: dev (everything) | personal | professional | team
# INBOX_DEFAULT_PLAN=dev
# Local development/tests only (ignored in production builds). Never set these in Vercel.
# INBOX_LOCAL_DEMO=1
# INBOX_SIMULATED_AI=1
