    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "chrono-node": "^2.10.3",
    "docx": "^9.10.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
